{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-cortex-posture-gateway",
  "main": "src/gateway-worker.ts",
  "account_id": "aa8ab6fe5b7f906df426a972033e922a",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "GATEWAY_ACCOUNT_TAG": "aa8ab6fe5b7f906df426a972033e922a",
    "GATEWAY_IP_MAX_AGE_MINUTES": "30"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cortex-posture",
      "database_id": "d8c19973-0a29-495b-bf6b-4716f02861f1",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}

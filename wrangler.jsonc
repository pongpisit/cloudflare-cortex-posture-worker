{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-cortex-posture-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://replace-me.cloudflareaccess.com",
    "ACCESS_AUD": "replace-with-access-application-aud",
    "CORTEX_BASE_URL": "https://replace-me.example.invalid"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cortex-posture",
      "database_id": "d8c19973-0a29-495b-bf6b-4716f02861f1",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "REFRESH_QUEUE",
        "queue": "cortex-posture-refresh"
      }
    ],
    "consumers": [
      {
        "queue": "cortex-posture-refresh",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_concurrency": 5,
        "max_retries": 5,
        "dead_letter_queue": "cortex-posture-refresh-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
